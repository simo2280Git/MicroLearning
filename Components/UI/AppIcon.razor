@* Shared/AppIcon.razor *@

<span class="d-inline-flex align-items-center justify-content-center"
      style="width: @(Size)px; height: @(Size)px;">
    <img src="img/@(Name).svg"
         style="width: 100%; height: 100%; filter: @CssFilter;"
         alt="@Name" />
</span>

@code {
    [Parameter] public string Name { get; set; } = string.Empty; // es. "bookmark"
    [Parameter] public int Size { get; set; } = 24;              // Dimensione in px

    // Proprietà opzionale per cambiare colore agli SVG neri tramite CSS filter
    [Parameter] public string? Color { get; set; }

    private string CssFilter => Color switch
    {
        "primary" => "invert(39%) sepia(80%) saturate(1500%) hue-rotate(200deg)", // Adatta al tuo colore
        "white" => "invert(100%)",
        _ => "none"
    };
}