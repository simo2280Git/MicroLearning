@using MicroLearning.Components.UI
@inject NavigationManager NavManager

<nav class="floating-nav-container">
    <div class="bottom-nav">
        <NavLink class="nav-item" href="discover" Match="NavLinkMatch.Prefix">
            <AppIcon Name="compass" Size="22" Color="white" />
        </NavLink>
        <NavLink class="nav-item" href="personal" Match="NavLinkMatch.Prefix">
            <AppIcon Name="lightbulb" Size="22" Color="white" />
        </NavLink>
        <NavLink class="nav-item" href="topics" Match="NavLinkMatch.Prefix">
            <AppIcon Name="clipboard-list" Size="22" Color="white" />
        </NavLink>
        <NavLink class="nav-item" href="profile" Match="NavLinkMatch.Prefix">
            <AppIcon Name="user-round" Size="22" Color="white" />
        </NavLink>
    </div>
</nav>

<style>
    .floating-nav-container {
        position: fixed;
        bottom: calc(20px + env(safe-area-inset-bottom, 0px));
        left: 0;
        right: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
        pointer-events: none; 
    }

    .bottom-nav {
        pointer-events: auto;
        width: min(88%, 340px);
        height: 60px;
        background-color: rgba(26, 33, 45, 0.75);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 999px;
        display: flex;
        justify-content: space-evenly;
        align-items: center;
        padding: 0 10px;
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5), 0 4px 12px rgba(0, 0, 0, 0.3);
        transition: transform 0.2s ease, background-color 0.3s ease;
    }

    .nav-item {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 46px;
        height: 46px;
        border-radius: 50%;
        text-decoration: none;
        opacity: 0.5;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .nav-item:hover {
        opacity: 0.85;
        background-color: rgba(255, 255, 255, 0.08);
    }

    .nav-item.active {
        opacity: 1;
        transform: scale(1.15);
        background-color: rgba(255, 255, 255, 0.12);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }
</style>