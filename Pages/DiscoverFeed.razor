@page "/discover"
@using MicroLearn.Models
@using MicroLearning.Components.UI
@using MicroLearning.Models
@using MicroLearning.Models.Context
@using MicroLearning.Services
@using Microsoft.AspNetCore.Authorization
@inject CardService CardService
@inject UserService UserService
@inject TopicService TopicService
@inject IJSRuntime JSRuntime
@implements IDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

<PageTitle>MicroLearning Feed</PageTitle>

@if (isLoading)
{
    <div class="feed-state-container">
        <div class="spinner-border text-accent mb-3" role="status" style="width: 3rem; height: 3rem;"></div>
        <p class="fw-semibold">L'AI sta preparando il tuo feed...</p>
    </div>
}
else if (!cards.Any())
{
    <div class="feed-state-container text-center p-4">
        <i class="bi bi-journal-x display-1 text-muted-custom mb-3"></i>
        <h4 class="text-main fw-bold">Nessuna card disponibile</h4>
        <p class="text-muted-custom">Assicurati di seguire almeno un argomento nelle impostazioni.</p>
    </div>
}
else
{
    <!-- Contenitore Principale a Scorrimento "Snap" -->
    <div class="tiktok-feed-container">
        @foreach (var card in cards)
        {
            <div class="tiktok-card-item" data-card-id="@card.Id">
                <div class="card-content-wrapper">

                    <!-- Header: Topic Badge con Cambio Dinamico Icona -->
                    <div class="mb-3">
                        <div class="badge-topic text-uppercase tracking-wider">
                            <span>@card.TopicName</span>

                            @if (IsTopicFollowed(card.TopicId))
                            {
                                <button type="button"
                                        class="btn-add-topic followed"
                                        disabled
                                        title="Argomento già seguito">
                                    <AppIcon Name="check" Size="18" Color="white" />
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn-add-topic"
                                        @onclick="() => AddTopic(card.TopicId)"
                                        title="Aggiungi topic ai tuoi preferiti">
                                    <AppIcon Name="circle-plus" Size="18" Color="white" />
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Titolo e Sottotitolo -->
                    <h2 class="fw-bold mb-2 text-main card-title-custom">@card.Title</h2>
                    <h5 class="text-muted-custom mb-4 fw-normal card-subtitle-custom">@card.Subtitle</h5>

                    <!-- Corpo principale della Card -->
                    <div class="card-body-scrollable">
                        <p class="fs-6 leading-relaxed text-main">@card.Body</p>

                        <!-- 🔍 TASTO PER LA RICERCA SU GOOGLE -->
                        <div class="mt-3">
                            <a href="https://www.google.com/search?q=@(string.IsNullOrEmpty(card.KeyWords) ? Uri.EscapeDataString(card.Title) : Uri.EscapeDataString(card.KeyWords))"
                               target="_blank" rel="noopener noreferrer" class="d-inline-flex align-items-center gap-2" style="padding: 0 !important;">
                                <AppIcon Name="globe-check" Size="16" Color="white" />
                            </a>
                        </div>

                        @if (!string.IsNullOrEmpty(card.DeepDive))
                        {
                            <div class="deep-dive-box mt-4 p-3 rounded-3">
                                <h6 class="fw-bold text-accent mb-1">💡 Per approfondire:</h6>
                                <p class="small text-muted-custom mb-0">@card.DeepDive</p>
                            </div>
                        }
                    </div>

                </div>
            </div>
        }
    </div>
}

<style>

</style>

@code {
    private Guid currentUserId;
    private List<CardModel> cards = new();
    private List<Topic?> userTopics = new();
    private bool isLoading = true;
    private bool shouldInitObserver = false;
    private DotNetObjectReference<DiscoverFeed>? dotNetHelper;
    private bool isFetchingMore = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            var user = await UserService.GetCurrentUserAsync();

            if (user != null && Guid.TryParse(user.Id, out currentUserId))
            {
                cards = await CardService.GetFeedCardsAsync(currentUserId);
                userTopics = await TopicService.GetUserTopicsAsync(currentUserId);
            }
            else
            {
                cards = new List<CardModel>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AVVIO FEED] Errore: {ex.Message}");
            cards = new List<CardModel>();
        }
        finally
        {
            isLoading = false;
            if (cards.Any())
            {
                shouldInitObserver = true;
            }
        }
    }

    private bool IsTopicFollowed(Guid topicId)
    {
        return userTopics.Any(t => t != null && t.Id == topicId);
    }

    private async Task AddTopic(Guid topicId)
    {
        // Controllo di sicurezza: se è già seguito non fa nulla
        if (IsTopicFollowed(topicId)) return;

        try
        {
            userTopics = await TopicService.AddUserTopicAsync(currentUserId, topicId);
            StateHasChanged(); // Aggiorna immediatamente l'interfaccia
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ADD TOPIC] Errore: {ex.Message}");
        }
    }

    [JSInvokable]
    public async Task OnCardVisibleAsync(string cardIdStr)
    {
        if (Guid.TryParse(cardIdStr, out Guid cardId) && currentUserId != Guid.Empty)
        {
            await CardService.MarkCardAsReadAsync(currentUserId, cardId);

            CardModel? card = cards.FirstOrDefault(x => x.Id == cardId);
            if (card != null)
            {
                int indexCard = cards.IndexOf(card);

                if (cards.Count - indexCard <= 4 && !isFetchingMore)
                {
                    isFetchingMore = true;

                    var currentCardIds = cards.Select(c => c.Id).ToList();

                    var newCards = await CardService.GetFeedCardsAsync(currentUserId, currentCardIds);

                    if (newCards.Any())
                    {
                        var uniqueNewCards = newCards.Where(nc => !cards.Any(c => c.Id == nc.Id)).ToList();

                        if (uniqueNewCards.Any())
                        {
                            cards.AddRange(uniqueNewCards);
                            StateHasChanged();

                            await Task.Delay(50);
                            await JSRuntime.InvokeVoidAsync("initCardObserver", dotNetHelper);
                        }
                    }

                    isFetchingMore = false;
                }
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldInitObserver)
        {
            shouldInitObserver = false;
            dotNetHelper = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("initCardObserver", dotNetHelper);
        }
    }

    public void Dispose()
    {
        dotNetHelper?.Dispose();
    }
}